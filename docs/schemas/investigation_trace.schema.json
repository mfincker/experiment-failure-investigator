{
  "$defs": {
    "AgentRuntimeConfig": {
      "additionalProperties": false,
      "description": "Strict configuration shared by the controller, model, and trace.",
      "properties": {
        "input_tokens_limit": {
          "default": 30000,
          "minimum": 1,
          "title": "Input Tokens Limit",
          "type": "integer"
        },
        "max_evidence_records": {
          "default": 25,
          "maximum": 50,
          "minimum": 1,
          "title": "Max Evidence Records",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 2048,
          "maximum": 32768,
          "minimum": 128,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "model_tag": {
          "default": "qwen2.5:7b",
          "maxLength": 200,
          "minLength": 1,
          "title": "Model Tag",
          "type": "string"
        },
        "ollama_base_url": {
          "default": "http://localhost:11434/v1",
          "title": "Ollama Base Url",
          "type": "string"
        },
        "output_tokens_limit": {
          "default": 4096,
          "minimum": 1,
          "title": "Output Tokens Limit",
          "type": "integer"
        },
        "output_validation_retries": {
          "default": 1,
          "maximum": 3,
          "minimum": 0,
          "title": "Output Validation Retries",
          "type": "integer"
        },
        "prompt_version": {
          "default": "1.0.0",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Prompt Version",
          "type": "string"
        },
        "provider": {
          "const": "ollama",
          "default": "ollama",
          "title": "Provider",
          "type": "string"
        },
        "request_limit": {
          "default": 4,
          "maximum": 10,
          "minimum": 1,
          "title": "Request Limit",
          "type": "integer"
        },
        "request_timeout_seconds": {
          "default": 120.0,
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Request Timeout Seconds",
          "type": "number"
        },
        "run_timeout_seconds": {
          "default": 300.0,
          "exclusiveMinimum": 0,
          "maximum": 1800,
          "title": "Run Timeout Seconds",
          "type": "number"
        },
        "runtime_mode": {
          "$ref": "#/$defs/RuntimeMode",
          "default": "local"
        },
        "temperature": {
          "default": 0.0,
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        },
        "tool_calls_limit": {
          "default": 3,
          "maximum": 10,
          "minimum": 0,
          "title": "Tool Calls Limit",
          "type": "integer"
        },
        "total_tokens_limit": {
          "default": 34096,
          "minimum": 1,
          "title": "Total Tokens Limit",
          "type": "integer"
        }
      },
      "title": "AgentRuntimeConfig",
      "type": "object"
    },
    "ConfidenceCategory": {
      "description": "Qualitative confidence without pretending the model is calibrated.",
      "enum": [
        "high",
        "moderate",
        "low",
        "indeterminate"
      ],
      "title": "ConfidenceCategory",
      "type": "string"
    },
    "FailureHypothesis": {
      "additionalProperties": false,
      "description": "One provisional mechanism grounded in deterministic evidence.",
      "properties": {
        "alternative_explanations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Alternative Explanations",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceCategory"
        },
        "contradicting_evidence_ids": {
          "default": [],
          "items": {
            "pattern": "^ev_[0-9a-f]{20}$",
            "type": "string"
          },
          "title": "Contradicting Evidence Ids",
          "type": "array"
        },
        "falsification_check": {
          "minLength": 1,
          "title": "Falsification Check",
          "type": "string"
        },
        "missing_evidence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Missing Evidence",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "proposed_mechanism": {
          "minLength": 1,
          "title": "Proposed Mechanism",
          "type": "string"
        },
        "rank": {
          "maximum": 4,
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "supporting_evidence_ids": {
          "default": [],
          "items": {
            "pattern": "^ev_[0-9a-f]{20}$",
            "type": "string"
          },
          "title": "Supporting Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "rank",
        "name",
        "proposed_mechanism",
        "confidence",
        "missing_evidence",
        "alternative_explanations",
        "falsification_check"
      ],
      "title": "FailureHypothesis",
      "type": "object"
    },
    "InvestigatorOutput": {
      "additionalProperties": false,
      "description": "Validated structured result returned by the Week 3 investigator.",
      "properties": {
        "case_id": {
          "pattern": "^case_[0-9a-f]{16}$",
          "title": "Case Id",
          "type": "string"
        },
        "hypotheses": {
          "items": {
            "$ref": "#/$defs/FailureHypothesis"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Hypotheses",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "overall_assessment": {
          "minLength": 1,
          "title": "Overall Assessment",
          "type": "string"
        },
        "recommendation_evidence_ids": {
          "items": {
            "pattern": "^ev_[0-9a-f]{20}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Recommendation Evidence Ids",
          "type": "array"
        },
        "recommended_next_check": {
          "minLength": 1,
          "title": "Recommended Next Check",
          "type": "string"
        },
        "remaining_uncertainty": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Remaining Uncertainty",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "hypotheses",
        "overall_assessment",
        "remaining_uncertainty",
        "recommended_next_check",
        "recommendation_evidence_ids",
        "limitations"
      ],
      "title": "InvestigatorOutput",
      "type": "object"
    },
    "JsonValue": {},
    "PublicArtifactHashes": {
      "additionalProperties": false,
      "description": "Verified hashes for the five investigator-visible case artifacts.",
      "properties": {
        "measurements": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Measurements",
          "type": "string"
        },
        "metadata": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Metadata",
          "type": "string"
        },
        "plate_map": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plate Map",
          "type": "string"
        },
        "problem_statement": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Problem Statement",
          "type": "string"
        },
        "protocol": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Protocol",
          "type": "string"
        }
      },
      "required": [
        "measurements",
        "plate_map",
        "metadata",
        "protocol",
        "problem_statement"
      ],
      "title": "PublicArtifactHashes",
      "type": "object"
    },
    "RunFailureCode": {
      "description": "Stable failure families exposed by the single-run controller.",
      "enum": [
        "provider_unavailable",
        "model_missing",
        "validation_failed",
        "budget_exhausted",
        "timeout",
        "internal_error"
      ],
      "title": "RunFailureCode",
      "type": "string"
    },
    "RunStatus": {
      "description": "Terminal status of one bounded investigator execution.",
      "enum": [
        "success",
        "failed"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "RuntimeMode": {
      "description": "Supported Week 3 execution profiles.",
      "enum": [
        "mock",
        "replay",
        "local",
        "smoke"
      ],
      "title": "RuntimeMode",
      "type": "string"
    },
    "TraceEvent": {
      "additionalProperties": false,
      "description": "One ordered model message or extracted tool exchange.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/TraceEventKind"
        },
        "payload": {
          "$ref": "#/$defs/JsonValue"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "tool_name": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Name"
        }
      },
      "required": [
        "sequence",
        "kind",
        "payload"
      ],
      "title": "TraceEvent",
      "type": "object"
    },
    "TraceEventKind": {
      "description": "Kinds of ordered framework activity retained in the trace.",
      "enum": [
        "model_request",
        "model_response",
        "validation_retry",
        "tool"
      ],
      "title": "TraceEventKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Validated persisted record of one bounded Investigator run.",
  "properties": {
    "application_commit": {
      "minLength": 1,
      "title": "Application Commit",
      "type": "string"
    },
    "baseline_report_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Baseline Report Version",
      "type": "string"
    },
    "case_id": {
      "pattern": "^case_[0-9a-f]{16}$",
      "title": "Case Id",
      "type": "string"
    },
    "config": {
      "$ref": "#/$defs/AgentRuntimeConfig"
    },
    "duration_seconds": {
      "minimum": 0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "events": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TraceEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "failure_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunFailureCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "failure_detail": {
      "anyOf": [
        {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Detail"
    },
    "heuristic_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Heuristic Version",
      "type": "string"
    },
    "input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Tokens"
    },
    "monetary_provider_cost_usd": {
      "default": 0.0,
      "minimum": 0,
      "title": "Monetary Provider Cost Usd",
      "type": "number"
    },
    "output": {
      "anyOf": [
        {
          "$ref": "#/$defs/InvestigatorOutput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "output_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Tokens"
    },
    "prompt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prompt Sha256",
      "type": "string"
    },
    "public_artifact_hashes": {
      "$ref": "#/$defs/PublicArtifactHashes"
    },
    "pydantic_ai_version": {
      "minLength": 1,
      "title": "Pydantic Ai Version",
      "type": "string"
    },
    "python_version": {
      "minLength": 1,
      "title": "Python Version",
      "type": "string"
    },
    "request_count": {
      "minimum": 0,
      "title": "Request Count",
      "type": "integer"
    },
    "run_id": {
      "pattern": "^run_[0-9a-f]{20}$",
      "title": "Run Id",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "tool_call_count": {
      "minimum": 0,
      "title": "Tool Call Count",
      "type": "integer"
    },
    "tool_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Tool Versions",
      "type": "object"
    },
    "total_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Tokens"
    },
    "trace_version": {
      "default": "2.0.0",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Trace Version",
      "type": "string"
    },
    "validation_attempts": {
      "default": 0,
      "minimum": 0,
      "title": "Validation Attempts",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "public_artifact_hashes",
    "application_commit",
    "python_version",
    "pydantic_ai_version",
    "config",
    "prompt_sha256",
    "baseline_report_version",
    "heuristic_version",
    "tool_versions",
    "status",
    "request_count",
    "tool_call_count",
    "started_at",
    "duration_seconds"
  ],
  "title": "InvestigationTrace",
  "type": "object"
}
